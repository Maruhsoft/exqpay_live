# Application
APP_NAME=ExqPay Live
APP_ENV=production
APP_DEBUG=false
APP_URL=https://exqpay.live
APP_TIMEZONE=UTC

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=exqpay_live
DB_USER=exqpay
DB_PASSWORD=secure_password_here
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Security
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
ENCRYPTION_KEY=your_encryption_key_minimum_32_characters
HMAC_SECRET=your_hmac_secret_key_minimum_32_characters

# Crypto Settings
BTC_CONFIRMATION_REQUIRED=3
ETH_CONFIRMATION_REQUIRED=12
BTC_NETWORK=mainnet
ETH_NETWORK=mainnet

# Blockchain APIs
BLOCKCHAIN_API_KEY=your_blockchain_api_key
INFURA_API_KEY=your_infura_api_key

# Exchange Rates
EXCHANGE_RATE_API=https://api.coingecko.com/api/v3
FIAT_CURRENCY=USD

# Withdrawal Settings
WITHDRAWAL_MIN_AMOUNT=100
WITHDRAWAL_MAX_AMOUNT=50000
WITHDRAWAL_DAILY_LIMIT=100000
WITHDRAWAL_FEE_PERCENT=2.5

# KYC Settings
KYC_REQUIRED=true
KYC_DOCUMENT_VERIFICATION_REQUIRED=true

# Session
SESSION_TIMEOUT=3600
SESSION_SECURE=true
SESSION_HTTPONLY=true
SESSION_SAMESITE=Strict

# Email
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@exqpay.live

# Logging
LOG_CHANNEL=file
LOG_LEVEL=warning

# Feature Flags
FEATURE_GIFT_CARDS=true
FEATURE_P2P_TRADING=false
FEATURE_API_WEBHOOK=true

# Redis (optional, for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
